    {
        "id": 3,
        "name": "チャーハン",
        "tags": ["egg","rice", "itameru", "siokarai","japanese","chinese"],
        "image": "photo/チャーハン.jpg",
        "summary": "パラパラご飯こそ至高！！！うめえええ",
        "ingredients":["ご飯 300g","薄切り豚肉 50g","長ネギ 20cm分","溶き卵 ３つ分","しょうがチューブ 1cm"
                        ,"[A]","鶏がらスープの素 小さじ1","塩 小さじ1/2","にんにくチューブ 2cm","黒コショウ 2つまみ","砂糖 小さじ1/2"
                        ,"","サラダ油 大さじ2と1/2","醤油 小さじ1","ごま油 1,2滴"],
        "steps":
        [
            "豚バラ薄切り肉は粗みじん切りにし、塩ひとつまみをふる。長ねぎは粗みじん切りにする。",
            "フライパンに油はひかずに豚バラ肉、長ねぎの1/2量を入れて強めの中火で焼く。",
            "長ねぎに焦げ目がついてきたら、弱めの中火にし、具材をフライパンの端によせる。空いたスペースにサラダ油としょうがチューブを入れ、フライパンを傾けて炒め、香りがたつまで火を通す。",
            "強めの中火にし、油の上から溶き卵を流し入れ、上にご飯をのせて木べらで全体を混ぜ合わせる。",
            "[A]を加えてパラっとするまで炒め合わせる。",
            "残りの長ねぎを加え、しょうゆをフライパンの縁に沿って回し入れたらザッと炒め合わせ火を止める。",
            "ごま油をかけて混ぜ合わせて盛り付ける。"
        ],
        "url":"https://oceans-nadia.com/user/253470/recipe/440737"
    },
